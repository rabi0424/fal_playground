// Cloudflare Workers の設定
// 静的アセット配信 + 端末間同期 API（worker.js / Durable Object）
{
  "name": "fal-playground",
  "main": "worker.js",
  "compatibility_date": "2026-07-09",
  // ダッシュボードで設定した環境変数（Text タイプ）をデプロイ時に消さない。
  // Secret タイプは元々保持されるが、誤って Text で登録された場合の保険
  "keep_vars": true,
  "assets": {
    "directory": "./"
  },
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "SyncState" }
    ]
  },
  // 生成画像の保存先（オブジェクトストレージ）。Durable Object の SQLite に
  // バイナリを詰めるのをやめ、R2 に置く。デプロイ前に同名のバケットを作成すること:
  //   npx wrangler r2 bucket create fal-playground-images
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "fal-playground-images" }
  ],
  // 生成履歴のカタログ（プロンプト・設定・画像への参照）。Durable Object の KV に
  // 索引を手で作るのをやめ、D1（SQLite）の表にする。アーカイブ側のアプリからも
  // 同じ DB をバインドして共有する前提。
  //
  // 別のアカウントで一から立てる場合は、D1 を作って database_id を差し替えること
  // （ダッシュボードの Storage & Databases → D1、または npx wrangler d1 create fal-playground）。
  // 表は Worker が最初に履歴へ触れたときに作るので、schema.sql の適用は不要
  "d1_databases": [
    { "binding": "DB", "database_name": "fal-playground", "database_id": "96c9475a-d9af-4299-94c8-e060ce6fb681" }
  ],
  // 無料プランでは SQLite バックエンドの Durable Object のみ利用可能
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncState"] }
  ]
}
